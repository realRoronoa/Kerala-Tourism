# NATPAC Kerala Mobility Platform Environment Variables

PROJECT_NAME="Kerala Mobility Platform"

# Primary PostgreSQL + PostGIS Database
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/kerala_mobility"

# High-Frequency Telemetry Redis Queue
REDIS_URL="redis://localhost:6379/0"

# Decoupled ML Microservice URL
ML_SERVICE_URL="http://localhost:8001"

# ------------------------------------------------------------------------------
# OPTIONAL EXTERNAL API KEYS
# Note: The platform automatically falls back to free open-access endpoints
# (OpenStreetMap, Nominatim, OSRM, Open-Meteo) if these keys are left empty.
# ------------------------------------------------------------------------------

# 1. Google Gemini API Key (For AI Tourism RAG Itinerary Generator)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 2. Mapbox Public Access Token (For custom map tiles & high-rate geocoding)
# Get key from: https://account.mapbox.com/
MAPBOX_API_KEY=""

# 3. OpenWeatherMap API Key (For detailed weather forecasts)
# Get key from: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=""

# 4. OpenRouteService API Key (For alternative road routing & matrix calculations)
# Get key from: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=""

# 5. Firebase Admin Credentials (For Mobile App Phone/Google SSO verification)
# Get JSON key from: https://console.firebase.google.com/ -> Project Settings -> Service Accounts
FIREBASE_CREDENTIALS_PATH=""
FIREBASE_PROJECT_ID="kerala-mobility-natpac"

